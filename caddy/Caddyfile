{$STATION_SITE:station.berserkbrah.com} {
    @picker path /webhook /current
    handle @picker {
        reverse_proxy picker:9000
    }

    handle /stream {
        reverse_proxy icecast:8000
    }

    # Everything else is the static site in web/, served from here rather
    # than proxied to Icecast. That keeps Icecast's own status and admin
    # pages off the public site; to see them, forward its local port over
    # SSH (ssh -L 8000:localhost:8000 <server>) and open localhost:8000.
    handle {
        root * /srv
        encode zstd gzip
        # the file name carries the version, so it can be cached for good
        header /vendor/* Cache-Control "public, max-age=31536000, immutable"
        file_server
    }
}
