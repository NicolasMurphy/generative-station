ICECAST_SOURCE_PASSWORD=replace-me
ICECAST_RELAY_PASSWORD=replace-me
ICECAST_ADMIN_PASSWORD=replace-me

# Bearer token the mass-spectrum converter sends to /webhook. While this is
# unset the picker rejects every webhook.
STATION_WEBHOOK_SECRET=replace-me

# Site address Caddy serves. Defaults to station.berserkbrah.com, with a real
# certificate. For a local run, serve plain HTTP on localhost instead:
# STATION_SITE=http://localhost
